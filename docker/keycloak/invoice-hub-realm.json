{
  "realm": "invoice-hub",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "invoice-uploader",
        "description": "Upload invoices"
      },
      {
        "name": "invoice-reader",
        "description": "Read invoices and validation reports"
      }
    ]
  },
  "clients": [
    {
      "clientId": "demo-uploader",
      "description": "Demo system that uploads invoices. The secret is only for local use.",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-uploader-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "invoice-hub audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "invoice-hub",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "demo-reader",
      "description": "Demo system that reads invoices. The secret is only for local use.",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-reader-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "invoice-hub audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "invoice-hub",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-demo-uploader",
      "enabled": true,
      "serviceAccountClientId": "demo-uploader",
      "realmRoles": ["invoice-uploader"]
    },
    {
      "username": "service-account-demo-reader",
      "enabled": true,
      "serviceAccountClientId": "demo-reader",
      "realmRoles": ["invoice-reader"]
    }
  ]
}
