        }
      },
      "description": "Counted since the start of invoice-hub. increase() would miss the first invoice of every new combination of labels."
    },
    {
      "type": "bargauge",
      "id": 10,
      "title": "Received by format",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (format) (invoicehub_invoices_received_total)",
          "legendFormat": "{{format}}",
